# ---------- Aplikacja ----------
# Publiczny adres strony (bez ukośnika na końcu) – używany w linkach w e-mailach, sitemap i Open Graph
APP_URL=http://localhost:3000
# Sekret aplikacji (min. 32 znaki) – szyfrowanie sekretów TOTP i podpisy formularzy.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Sekret dla zadań cyklicznych (min. 16 znaków; nagłówek Authorization: Bearer ...)
CRON_SECRET=
# Domena dla Caddy w docker-compose (bez https://), np. motopuls.pl
DOMAIN=

# ---------- Baza danych ----------
DATABASE_URL=postgresql://motopuls:motopuls@localhost:5432/motopuls
# Używane tylko przez docker-compose
POSTGRES_PASSWORD=

# ---------- Konto startowe (seed) ----------
ADMIN_EMAIL=motopuls.serwis@gmail.com
ADMIN_NAME=Właściciel

# ---------- E-mail (SMTP; Resend: host smtp.resend.com, user "resend", hasło = klucz API) ----------
# Bez SMTP_HOST wiadomości są zapisywane do katalogu .mail-outbox (tryb deweloperski)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Moto Puls <rezerwacje@example.com>"
# Adres, na który trafiają powiadomienia warsztatu (domyślnie e-mail firmy z ustawień)
WORKSHOP_NOTIFY_EMAIL=

# ---------- Antyspam (opcjonalnie Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Minimalny czas (s) od wyświetlenia do wysłania formularza; domyślna wartość jest w src/lib/env.ts
# ANTISPAM_MIN_SECONDS=

# ---------- Pliki ----------
UPLOAD_DIR=./uploads
